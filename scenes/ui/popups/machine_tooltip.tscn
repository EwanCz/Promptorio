[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/machine_tooltip.gd" id="1_script"]
[ext_resource type="Theme" path="res://data/ui/theme.tres" id="2_theme"]

[node name="MachineTooltip" type="PanelContainer"]
size_flags_vertical = 3
size_flags_stretch_ratio = 1.0
theme = ExtResource("2_theme")
theme_type_variation = &"BarSection"
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
