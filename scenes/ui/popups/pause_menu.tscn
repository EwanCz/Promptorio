[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://data/ui/theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/ui/pixel_button.gd" id="3_pixel"]

[node name="PauseMenu" type="PanelContainer"]
process_mode = 3
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Paused"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
script = ExtResource("3_pixel")
texture_base = "res://assets/pixel_ui_pack/pause_resume"
fallback_text = "RESUME"

[node name="RestartButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
script = ExtResource("3_pixel")
texture_base = "res://assets/pixel_ui_pack/pause_restart"
fallback_text = "RESTART"

[node name="MainMenuButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
script = ExtResource("3_pixel")
texture_base = "res://assets/pixel_ui_pack/pause_main_menu"
fallback_text = "MAIN MENU"

[node name="Hint" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Unsaved progress is lost."
horizontal_alignment = 1
