# Dev-only keys, read by the editor build. Copy to .env (git-ignored); the Settings dialog key wins when set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional, editor runs only: a compatible relay per provider (https origin, no path).
# Precedence: Settings dialog Base URL, then the process environment, then this file.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
