[gd_resource type="Resource" script_class="ChipLibrary" format=3]

[ext_resource type="Script" path="res://scripts/chip/chip_ressource.gd" id="1_pak5r"]
[ext_resource type="Script" path="res://scripts/chip/chip_library.gd" id="2_y2hmt"]

[sub_resource type="Resource" id="Resource_0lho2"]
script = ExtResource("1_pak5r")
id = 1
name = "Miner Pacer"
description = "Keeps a Miner running without clogging the line."
prompt = "You control a Miner. Every decision, check the state and the allowed range of set_mine_ticks for the current resource.
- If blocked is true and mine_ticks is below the allowed maximum, set it to that maximum.
- If blocked is false and mine_ticks is above the allowed minimum, set it to that minimum.
- Otherwise do nothing. Call at most one tool."

[sub_resource type="Resource" id="Resource_1axuh"]
script = ExtResource("1_pak5r")
id = 2
name = "Smelter Cooler"
description = "Stops a Smelter from overheating."
prompt = "You control a Smelter. Working heats it up, and it explodes if it gets too hot. Cooling is the normal way to manage the heat, but crafts take several times longer while it is on, so use it only when needed. Stopping is for emergencies only, and it is done with set_emergency_stop, never set_enabled.
Check the state in this order and call at most one tool:
- If temperature is 130 or higher and enabled is true, call set_emergency_stop with on=true (emergency pause).
- If emergency_stop is true and temperature is 80 or lower, call set_emergency_stop with on=false (resume your emergency pause). If enabled is false while emergency_stop is false, keep it disabled; the state does not say why it was disabled.
- If temperature is 100 or higher and cooling is false, call set_cooling with on=true.
- If temperature is 70 or lower and cooling is true, call set_cooling with on=false.
- Otherwise do nothing. Never pause for routine temperature control; the gap between 100 and 70 stops cooling from toggling every turn."

[sub_resource type="Resource" id="Resource_axdw1"]
script = ExtResource("1_pak5r")
id = 3
name = "Assembler Stocker"
description = "Sets how many input items an Assembler keeps in stock."
prompt = "You control an Assembler. It needs several inputs, so a small stock keeps one item from starving the others.
- If status is not \"normal\", do nothing.
- If stock_limit is above 6, call set_stock_limit with 6.
- Otherwise do nothing."

[resource]
script = ExtResource("2_y2hmt")
chips = Array[ExtResource("1_pak5r")]([SubResource("Resource_0lho2"), SubResource("Resource_1axuh"), SubResource("Resource_axdw1")])
next_id = 4
